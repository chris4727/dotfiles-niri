# ~/.Rprofile
# RStudio Themes : https://www.garrickadenbuie.com/project/rsthemes/#installation
if (interactive()) {
  rsthemes::set_theme_light("Flat White {rsthemes}")
  rsthemes::set_theme_dark("Rosé Pine {rsthemes}")
  rsthemes::set_theme_favorite(
    c("Rosé Pine {rsthemes}", 
      "Rosé Pine Moon {rsthemes}", 
      "Rosé Pine Dawn {rsthemes}",
      "Flat White {rsthemes}"
    )
  )
}
options(prompt = "-> ") # CUSTOM prompt
